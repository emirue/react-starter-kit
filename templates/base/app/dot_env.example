# Copy to .env.local and adjust. Never commit real secrets.
# Every VITE_* variable is embedded in the browser bundle and is PUBLIC.
VITE_APP_NAME={{appName}}
# @if api-client
# Base URL of your HTTP API. Relative values go through the dev server.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=10000
# @endif
# @if vite-proxy
# Development only: where the Vite dev server proxies /api requests.
VITE_PROXY_TARGET=http://localhost:3000
# @endif
# @if msw
# Set to "false" to disable the mock API in development.
VITE_ENABLE_MOCKS=true
# @endif
